# UniPark · Plantilla de configuración
# Copia este archivo como .env y completa los valores. Nunca subas .env a Git.

# local | produccion
APP_ENV=local
# 1 muestra errores en pantalla (solo desarrollo). En producción debe ser 0.
APP_DEBUG=0
# Minutos de inactividad antes de cerrar la sesión (RN-14).
SESSION_IDLE_MINUTES=15

# Cuenta de la aplicación: privilegios mínimos, nunca root (RNF-03, sección 9.2).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=unipark_db
DB_USER=unipark_app
DB_PASS=cambia-esta-clave

# Cuenta administrativa: solo para scripts de instalación, pruebas y respaldos.
DB_ADMIN_USER=root
DB_ADMIN_PASS=

# Base de datos que las pruebas borran y recrean en cada caso.
TEST_DB_NAME=unipark_test

# Carpeta con mysql y mysqldump (vacío = usar el PATH del sistema).
MYSQL_BIN_DIR=C:/xampp/mysql/bin

# Cobro automático por URL para hostings sin cron de consola: /cron/cobros?token=… (vacío = deshabilitado).
CRON_TOKEN=
# Confianza mínima de la IA para aceptar el tipo de vehículo (0 a 1). Por debajo, clasificación manual.
IA_UMBRAL=0.80
# Contacto del remitente de las notificaciones push (mailto: o https:). Algunos servicios lo exigen real.
PUSH_SUBJECT=mailto:parqueadero@unipark.test

# --- Recargas VOLUNTARIAS en línea del saldo prepago (docs/recargas-en-linea.md) ---
# Vacío = deshabilitadas (solo recarga en Caja). WOMPI = habilitadas con Wompi.
PASARELA_PROVEEDOR=
# sandbox (pruebas, sin dinero real) | produccion (exige WOMPI_PRODUCCION_AUTORIZADA=1 y llaves *_prod_)
WOMPI_ENTORNO=sandbox
WOMPI_PRODUCCION_AUTORIZADA=0
# Llaves del panel de comercios de Wompi (Desarrolladores). En sandbox empiezan por pub_test_, prv_test_,
# test_events_ y test_integrity_. Nunca las subas a Git.
WOMPI_LLAVE_PUBLICA=
WOMPI_LLAVE_PRIVADA=
WOMPI_SECRETO_EVENTOS=
WOMPI_SECRETO_INTEGRIDAD=
# Dirección pública HTTPS del sitio, para volver de la página de pago (por ejemplo https://parqueadero.ejemplo.edu.co/UniPark).
APP_URL=
# Valores sugeridos (pesos, separados por coma) y límites de cada recarga.
RECARGA_LINEA_VALORES=10000,20000,30000,50000,100000
RECARGA_LINEA_MINIMA=10000
RECARGA_LINEA_MAXIMA=500000
RECARGA_LINEA_EXPIRA_MIN=60
# 1 = además de la firma del webhook, consultar la transacción a Wompi antes de acreditar (recomendado).
PASARELA_VERIFICAR_CONSULTA=1
