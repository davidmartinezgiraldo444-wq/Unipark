# UniPark · Ejemplo de configuración de PRODUCCIÓN (Linux + Apache + PHP 8.2 + MariaDB/MySQL)
# Copia este archivo como .env (o usa el instalador web, que escribe config/env.php) y reemplaza
# TODOS los valores <...>. Este archivo no contiene contraseñas reales. Nunca subas .env a Git.
# Permisos recomendados: chmod 640 .env ; chown root:www-data .env

APP_ENV=produccion
# Nunca 1 en producción: los errores se registran en storage/logs, no en pantalla.
APP_DEBUG=0

# Sesión: minutos de inactividad del personal; los dispositivos fijos tienen su propio límite.
SESSION_IDLE_MINUTES=15
SESSION_IDLE_PORTERIA_MIN=480
SESSION_IDLE_DISPOSITIVO_MIN=720

# Cuenta de la APLICACIÓN: privilegios mínimos (SELECT, INSERT, UPDATE; sin DELETE ni DDL). Nunca root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=unipark_db
DB_USER=unipark_app
DB_PASS=<contraseña larga y aleatoria, solo para la aplicación>

# Cuenta ADMINISTRATIVA: solo la usan instalación, migraciones y respaldos desde la consola.
# Si los respaldos se hacen con otra herramienta, deja estas dos líneas vacías en el servidor web.
DB_ADMIN_USER=<cuenta de administración de la base>
DB_ADMIN_PASS=<contraseña de esa cuenta>

# No se usa en producción (solo las pruebas automáticas). Déjala apuntando a una base que no exista.
TEST_DB_NAME=unipark_db_test

# Carpeta de mysql y mysqldump (en Linux suele bastar el PATH: déjalo vacío).
MYSQL_BIN_DIR=

# Cobro automático: en Linux usa CRON de consola (ver docs/despliegue-produccion.md) y deja esto VACÍO.
# Solo si el hosting no permite cron de consola: token aleatorio de 32 caracteres o más.
CRON_TOKEN=

# IA de vehículos. Umbral y margen se ajustan con el reporte «Calibración de la IA».
IA_UMBRAL=0.80
IA_MARGEN=0.25
# 1 = guardar la foto del carril para el portero cuando la IA duda (se borra al resolver). 0 = no guardar.
IA_CAPTURA_PORTERO=0

# Remitente de las notificaciones push: correo real del área responsable del parqueadero.
PUSH_SUBJECT=mailto:<correo del área responsable>

# Recargas VOLUNTARIAS en línea (docs/recargas-en-linea.md). La persona inicia y autoriza cada recarga;
# UniPark nunca debita tarjetas ni cuentas. Deja PASARELA_PROVEEDOR vacío hasta tener la cuenta aprobada.
PASARELA_PROVEEDOR=<vacío o WOMPI>
# Primero sandbox. Pasar a produccion SOLO con autorización expresa de la institución.
WOMPI_ENTORNO=sandbox
WOMPI_PRODUCCION_AUTORIZADA=0
WOMPI_LLAVE_PUBLICA=<llave pública del comercio>
WOMPI_LLAVE_PRIVADA=<llave privada del comercio: solo en el servidor>
WOMPI_SECRETO_EVENTOS=<secreto de eventos del comercio>
WOMPI_SECRETO_INTEGRIDAD=<secreto de integridad del comercio>
APP_URL=https://<dominio>/<ruta de UniPark>
RECARGA_LINEA_VALORES=10000,20000,30000,50000,100000
RECARGA_LINEA_MINIMA=10000
RECARGA_LINEA_MAXIMA=500000
RECARGA_LINEA_EXPIRA_MIN=60
PASARELA_VERIFICAR_CONSULTA=1
