{
    "name": "lasallista/unipark",
    "description": "Sistema de control de acceso y operación del parqueadero universitario.",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "scripts": {
        "install-db": "php scripts/install.php",
        "test": "php tests/run.php",
        "serve": "php -S localhost:8000 index.php"
    },
    "config": {
        "sort-packages": true
    }
}
